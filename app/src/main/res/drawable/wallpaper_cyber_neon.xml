<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="1920dp"
    android:height="1080dp"
    android:viewportWidth="1920"
    android:viewportHeight="1080">

    <!-- Deep Space Background -->
    <path
        android:pathData="M0,0h1920v1080h-1920z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="960"
                android:startY="0"
                android:endX="960"
                android:endY="1080"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF08090E"/>
                <item android:offset="0.5" android:color="#FF0F111A"/>
                <item android:offset="1.0" android:color="#FF07080D"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Neon Ribbon 1 -->
    <path
        android:pathData="M-100,500 C400,200 900,650 1400,350 C1700,180 1900,280 2050,220 L2050,450 C1850,520 1600,420 1300,580 C800,850 350,420 -100,700 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="200"
                android:endX="2000"
                android:endY="600"
                android:type="linear">
                <item android:offset="0.0" android:color="#006366F1"/>
                <item android:offset="0.3" android:color="#448B5CF6"/>
                <item android:offset="0.7" android:color="#33EC4899"/>
                <item android:offset="1.0" android:color="#003B82F6"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Neon Ribbon 2 -->
    <path
        android:pathData="M-100,380 C300,600 850,250 1350,550 C1650,720 1900,480 2050,550 L2050,680 C1850,600 1600,850 1250,700 C750,450 300,750 -100,550 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="350"
                android:endX="2000"
                android:endY="750"
                android:type="linear">
                <item android:offset="0.0" android:color="#0006B6D4"/>
                <item android:offset="0.4" android:color="#333B82F6"/>
                <item android:offset="0.8" android:color="#448B5CF6"/>
                <item android:offset="1.0" android:color="#00EC4899"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ambient Center Glow Orb -->
    <path
        android:pathData="M960,420m-350,0a350,350 0,1 1,700 0a350,350 0,1 1,-700 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="960"
                android:startY="70"
                android:endX="960"
                android:endY="770"
                android:type="linear">
                <item android:offset="0.0" android:color="#1A6366F1"/>
                <item android:offset="0.5" android:color="#0FA855F7"/>
                <item android:offset="1.0" android:color="#00000000"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottom Scrim for Dock Legibility -->
    <path
        android:pathData="M0,560h1920v520h-1920z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="960"
                android:startY="560"
                android:endX="960"
                android:endY="1080"
                android:type="linear">
                <item android:offset="0.0" android:color="#00000000"/>
                <item android:offset="0.5" android:color="#9907080D"/>
                <item android:offset="1.0" android:color="#F407080D"/>
            </gradient>
        </aapt:attr>
    </path>

</vector>

