<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the self-update flow be tested against a plain-HTTP server on the host
     machine (the emulator reaches it at 10.0.2.2). Release builds keep the default (HTTPS only). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
